{{- $enlaces := slice -}}
{{- range (site.GetPage (printf "/%s" .Params.seccion)).RegularPages -}}
{{- $enlaces = $enlaces | append (dict "url" .RelPermalink "titulo" .Title) -}}
{{- end -}}
{{- range where hugo.Data.tienda "seccion" .Params.seccion -}}
{{- $enlaces = $enlaces | append (dict "url" .url "titulo" (printf "Tienda: %s" .titulo)) -}}
{{- end -}}
{{- jsonify (dict "enlaces" $enlaces "plantas" (cond (eq .Params.herramienta "plantas") hugo.Data.plantas slice)) -}}
